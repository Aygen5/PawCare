rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Kullanıcı profilleri ve alt bildirim koleksiyonu
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      
      match /notifications/{notifId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Köpek profilleri
    match /dogs/{dogId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && 
        (resource.data.ownerId == request.auth.uid || request.resource.data.ownerId == request.auth.uid);
    }

    // Rezervasyonlar: Sahip ve Bakıcı güvenli erişim
    match /bookings/{bookingId} {
      allow read: if request.auth != null && 
        (resource.data.ownerId == request.auth.uid || resource.data.sitterId == request.auth.uid);
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && 
        (resource.data.ownerId == request.auth.uid || resource.data.sitterId == request.auth.uid);
    }

    // Canlı GPS Yürüyüş Takibi
    match /live_walks/{walkId} {
      allow read, write: if request.auth != null;
    }

    // Gerçek Zamanlı Mesajlaşma (Sohbet Odaları ve Mesajlar)
    match /chats/{chatId} {
      allow read, write: if request.auth != null;
      
      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if request.auth != null && resource.data.senderId == request.auth.uid;
      }
    }

    // Bakıcı Profilleri (Keşfet ekranı için genel okuma)
    match /sitters/{sitterId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
